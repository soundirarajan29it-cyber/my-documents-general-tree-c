#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Node {
    char name[50];
    struct Node *child[10];
    int count;
};

// Create folder
struct Node* createNode(char name[]) {
    struct Node* newNode =
        (struct Node*)malloc(sizeof(struct Node));

    strcpy(newNode->name, name);
    newNode->count = 0;

    return newNode;
}

// Add sub-folder
void addChild(struct Node* parent,
              struct Node* child) {

    parent->child[parent->count] = child;
    parent->count++;
}

// Display tree
void display(struct Node* root, int level) {

    for(int i = 0; i < level; i++)
        printf("   ");

    printf("|-- %s\n", root->name);

    for(int i = 0; i < root->count; i++)
        display(root->child[i], level + 1);
}

int main() {

    struct Node* root =
        createNode("My Documents");

    struct Node* photos =
        createNode("Photos");

    struct Node* college =
        createNode("College");

    struct Node* projects =
        createNode("Projects");

    addChild(root, photos);
    addChild(root, college);
    addChild(root, projects);

    printf("General Tree Structure:\n\n");

    display(root, 0);

    return 0;
}
